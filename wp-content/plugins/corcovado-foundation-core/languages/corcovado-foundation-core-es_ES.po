msgstr "Información del archivo (p. ej. \"PDF | EN | 4.2 MB\")"

msgid "Publication date (used for ordering)"
msgstr "Fecha de publicación (se usa para ordenar)"

msgid "Featured (shown in the first library grid)"
msgstr "Destacado (se muestra en la primera cuadrícula de la biblioteca)"

msgid "Image description (alt, empty = title)"
msgstr "Descripción de la imagen (alt; vacío = título)"

msgid "Website"
msgstr "Sitio web"

msgid "Logo description (alt, empty = name)"
msgstr "Descripción del logo (alt; vacío = nombre)"

msgid "Sponsor category key (e.g. founding, supporters, gold, silver, bronze; empty = none)"
msgstr "Clave de categoría de patrocinio (p. ej. founding, supporters, gold, silver, bronze; vacío = ninguna)"

msgid "Language and translation"
msgstr "Idioma y traducción"

msgid "Details"
msgstr "Detalles"

