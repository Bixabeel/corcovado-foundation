msgstr "Idioma"

msgid "Spanish pages are the Spanish home page (/es/) and its child pages. Choose the parent in \"Page Attributes\"."
msgstr "Las páginas en español son la página de inicio en español (/es/) y sus páginas hijas. Elige la página superior en \"Atributos de página\"."

msgid "Translation"
msgstr "Traducción"

msgid "— None —"
msgstr "— Ninguna —"

msgid "Edit translation"
msgstr "Editar traducción"

msgid "Create translation (draft)"
msgstr "Crear traducción (borrador)"

msgid "Photo: use \"Featured image\". Group: choose it in \"Team groups\". Order: \"Page Attributes → Order\"."
msgstr "Foto: usa la \"Imagen destacada\". Grupo: elígelo en \"Grupos del equipo\". Orden: \"Atributos de página → Orden\"."

msgid "Logo: use \"Featured image\". Order: \"Page Attributes → Order\". Partners are shown in both languages."
msgstr "Logo: usa la \"Imagen destacada\". Orden: \"Atributos de página → Orden\". Los aliados se muestran en ambos idiomas."

msgid "Thumbnail: use \"Featured image\". Category: choose it in \"Resource categories\". To archive a resource, switch it to Draft."
msgstr "Miniatura: usa la \"Imagen destacada\". Categoría: elígela en \"Categorías de recursos\". Para archivar un recurso, pásalo a Borrador."

msgid "Image: use \"Featured image\" (optional). To unpublish an event, switch it to Draft."
msgstr "Imagen: usa la \"Imagen destacada\" (opcional). Para despublicar un evento, pásalo a Borrador."

msgid "Choose file"
msgstr "Elegir archivo"

msgid "Create translation"
msgstr "Crear traducción"

msgid "You are not allowed to do this."
msgstr "No tienes permiso para hacer esto."

msgid "Set the Spanish home page first (Corcovado Foundation → Settings)."
msgstr "Primero define la página de inicio en español (Fundación Corcovado → Ajustes)."

msgid "All languages"
msgstr "Todos los idiomas"

msgid "Order"
msgstr "Orden"

msgid "Spanish home (/es/)"
msgstr "Inicio en español (/es/)"

