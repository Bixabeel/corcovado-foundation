msgid "English home page"
msgstr "Página de inicio en inglés"

msgid "The English home page is the WordPress front page (Settings → Reading)."
msgstr "La página de inicio en inglés es la portada de WordPress (Ajustes → Lectura)."

msgid "Spanish home page (/es/)"
msgstr "Página de inicio en español (/es/)"

msgid "Every page placed under this page (as a child page) is Spanish and is published under /es/."
msgstr "Toda página colocada bajo esta página (como página hija) está en español y se publica bajo /es/."

msgid "Organization name in Spanish"
msgstr "Nombre de la organización en español"

msgid "Used in titles and share tags of Spanish pages. The English name is the Site Title (Settings → General)."
msgstr "Se usa en los títulos y etiquetas para compartir de las páginas en español. El nombre en inglés es el Título del sitio (Ajustes → Generales)."

msgid "404 content (English)"
msgstr "Contenido 404 (inglés)"

msgid "404 content (Spanish)"
msgstr "Contenido 404 (español)"

msgid "Keep these pages Private: their sections are shown on \"page not found\" errors."
msgstr "Mantén estas páginas en Privado: sus secciones se muestran en los errores de \"página no encontrada\"."

msgid "Donations (Classy)"
msgstr "Donaciones (Classy)"

msgid "Classy campaign ID"
msgstr "ID de campaña de Classy"

msgid "Public campaign identifier used by the embedded donation form. Never paste API keys or secrets here."
msgstr "Identificador público de campaña que usa el formulario de donación incrustado. Nunca pegues aquí claves de API ni secretos."

msgid "Forms"
msgstr "Formularios"

msgid "Recipient email"
msgstr "Correo destinatario"

msgid "Contact and volunteer messages are emailed here. Messages are not stored in the database."
msgstr "Los mensajes de contacto y voluntariado se envían por correo a esta dirección. Los mensajes no se guardan en la base de datos."

msgid "Max. messages per visitor per hour"
msgstr "Máx. de mensajes por visitante por hora"

msgid "SEO"
msgstr "SEO"

msgid "SEO tags output"
msgstr "Salida de etiquetas SEO"

msgid "Automatic (off if an SEO plugin is active)"
msgstr "Automática (desactivada si hay un plugin de SEO activo)"

msgid "Always on"
msgstr "Siempre activa"

msgid "Off"
msgstr "Desactivada"

msgid "Titles, meta description, Open Graph and Twitter Cards. hreflang/x-default are always printed (they depend on the translation links). Canonical URLs and the sitemap are provided by WordPress itself."
msgstr "Títulos, meta descripción, Open Graph y Twitter Cards. hreflang/x-default se imprimen siempre (dependen de los enlaces de traducción). Las URL canónicas y el sitemap los genera WordPress."

msgid "Organization structured data"
msgstr "Datos estructurados de la organización"

msgid "Output NGO JSON-LD on the home pages"
msgstr "Imprimir JSON-LD de ONG en las páginas de inicio"

msgid "Default share image"
msgstr "Imagen predeterminada para compartir"

msgid "Media Library attachment ID used for og:image / twitter:image when a page has no hero image."
msgstr "ID del adjunto de la Biblioteca de medios usado como og:image / twitter:image cuando una página no tiene imagen principal."

msgid "Advanced"
msgstr "Avanzado"

msgid "Legacy .html redirects"
msgstr "Redirecciones de .html antiguas"

msgid "Redirect old static URLs (/about-us.html, /library/*.pdf…) to their WordPress equivalent with a single 301."
msgstr "Redirige las URL estáticas antiguas (/about-us.html, /library/*.pdf…) a su equivalente en WordPress con una sola redirección 301."

msgid "Behind Cloudflare"
msgstr "Detrás de Cloudflare"

msgid "The site is served through the Cloudflare proxy: use the CF-Connecting-IP header to identify visitors in the form rate limit. Enable only if the server accepts traffic from Cloudflare exclusively."
msgstr "El sitio se sirve a través del proxy de Cloudflare: usar la cabecera CF-Connecting-IP para identificar a los visitantes en el límite de envíos. Actívalo solo si el servidor acepta tráfico exclusivamente de Cloudflare."

msgid "Security headers"
msgstr "Cabeceras de seguridad"

msgid "Send X-Content-Type-Options, Referrer-Policy, Permissions-Policy and X-Frame-Options (same values as the static site)."
msgstr "Enviar X-Content-Type-Options, Referrer-Policy, Permissions-Policy y X-Frame-Options (mismos valores que el sitio estático)."

msgid "Default logo (logo.png)"
msgstr "Logo predeterminado (logo.png)"

msgid "Home logo (logo1.png)"
msgstr "Logo de inicio (logo1.png)"

msgid "Vector logo (logo-funcorco.svg)"
msgstr "Logo vectorial (logo-funcorco.svg)"

msgid "English logo (logo_en.png)"
msgstr "Logo en inglés (logo_en.png)"

msgid "Footer with text icons (FB / IG / @)"
msgstr "Pie de página con iconos de texto (FB / IG / @)"

msgid "Footer with drawn social icons"
msgstr "Pie de página con iconos sociales dibujados"

msgid "Default footer logo (logo-border.webp)"
msgstr "Logo predeterminado del pie (logo-border.webp)"

msgid "Import / Migration"
msgstr "Importación / Migración"

msgid "Corcovado Foundation — Import / Migration"
msgstr "Fundación Corcovado — Importación / Migración"

msgid "Imports the content of the original static website (pages, images, PDFs, news, events, team, library, partners, translations, menus). It can be run several times: items already imported are recognised and never duplicated. Nothing is ever deleted."
msgstr "Importa el contenido del sitio estático original (páginas, imágenes, PDF, noticias, eventos, equipo, biblioteca, aliados, traducciones, menús). Se puede ejecutar varias veces: los elementos ya importados se reconocen y nunca se duplican. Nunca se elimina nada."

msgid "Content to import"
msgstr "Contenido a importar"

msgid "Pages"
msgstr "Páginas"

msgid "Images and documents"
msgstr "Imágenes y documentos"

msgid "Team members"
msgstr "Miembros del equipo"

msgid "Library resources"
msgstr "Recursos de la biblioteca"

msgid "Source"
msgstr "Origen"

msgid "%d original files are not in migration/source/. Use the packaged plugin ZIP (it contains them) or copy the assets/ and library/ folders of the static site there."
msgstr "Faltan %d archivos originales en migration/source/. Usa el ZIP empaquetado del plugin (los incluye) o copia allí las carpetas assets/ y library/ del sitio estático."

msgid "Activate the \"Corcovado Foundation\" theme first so that menus and header/footer texts can be imported."
msgstr "Activa primero el tema \"Corcovado Foundation\" para poder importar los menús y los textos del encabezado y pie."

msgid "Create menus and header/footer texts (only where none exist yet)"
msgstr "Crear menús y textos del encabezado/pie (solo donde aún no existan)"

msgid "Configure the site: front page = Home, permalinks \"/%postname%\", comments closed by default"
msgstr "Configurar el sitio: portada = Inicio, enlaces permanentes \"/%postname%\", comentarios cerrados por defecto"

msgid "Refresh items that were already imported with the original content (overwrites edits made to those items)"
msgstr "Actualizar los elementos ya importados con el contenido original (sobrescribe las ediciones hechas en esos elementos)"

msgid "Dry run (simulate, write nothing)"
msgstr "Simulación (no escribe nada)"

msgid "Run import"
msgstr "Ejecutar importación"

msgid "Last dry run"
msgstr "Última simulación"

msgid "Last import"
msgstr "Última importación"

msgid "migration/data/content.json is missing."
msgstr "Falta migration/data/content.json."

msgid "migration/data/content.json is not valid."
msgstr "migration/data/content.json no es válido."

msgid "Hide the publication date on the story page"
msgstr "Ocultar la fecha de publicación en la página de la noticia"

