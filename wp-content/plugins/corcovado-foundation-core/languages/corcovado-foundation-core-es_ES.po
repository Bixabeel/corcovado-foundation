msgid "Photo description (alt, empty = name)"
msgstr "Descripción de la foto (alt; vacío = nombre)"

msgid "Show the generic silhouette if the photo fails to load"
msgstr "Mostrar la silueta genérica si la foto no carga"

msgid "File to download"
msgstr "Archivo para descargar"

